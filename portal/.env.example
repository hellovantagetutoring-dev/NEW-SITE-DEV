# Copy to .env.local after creating a free Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (local or Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free consult booking (shown on Masterclass tab)
NEXT_PUBLIC_CONSULT_URL=https://calendly.com/hello-vantagetutoring/10min

# Existing Formspree endpoint for reschedule notifications
FORMSPREE_ENDPOINT=https://formspree.io/f/xnjenyao

# Comma-separated admin emails (first login for these becomes admin if profile missing)
ADMIN_EMAILS=jason@vantagetutoring.com.au
